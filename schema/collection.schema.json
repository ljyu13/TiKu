{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ljyu13/TiKu/main/schema/collection.schema.json",
  "title": "TiKu 来源集",
  "description": "banks/<来源集>/collection.json 的结构约束。",
  "type": "object",
  "required": ["id", "title", "origin", "source", "license", "maintainers"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "origin": { "enum": ["third_party", "original"] },
    "source": { "type": "string", "minLength": 1, "maxLength": 200 },
    "sourceUrl": { "type": "string", "pattern": "^https?://\\S+$" },
    "license": { "type": "string", "minLength": 1, "maxLength": 200 },
    "obtainedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$" }
    },
    "notes": { "type": "string", "minLength": 1, "maxLength": 5000 }
  }
}
