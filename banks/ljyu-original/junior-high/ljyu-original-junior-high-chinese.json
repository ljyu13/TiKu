      "id": "ljyu-jh-cn-01",
      "grade": 7,
      "questionType": "single_choice",
      "text": "下列词语中划线字读音完全正确的一项是？",
      "options": {
        "A": "狭隘（yì）",
        "B": "确凿（záo）",
        "C": "粗犷（kuàng）",
        "D": "怂恿（yǔ）"
      },
      "answer": "B",
      "analysis": "A 项“狭隘”的“隘”读 ài；C 项“粗犷”的“犷”读 guǎng；D 项“怂恿”的“恿”读 yǒng。B 项正确。",
      "knowledgePoints": [
        "字音"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
