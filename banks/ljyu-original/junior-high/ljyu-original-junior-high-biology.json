      "grade": 7,
      "questionType": "single_choice",
      "text": "植物细胞区别于动物细胞的结构是？",
      "options": {
        "A": "细胞膜",
        "B": "细胞核",
        "C": "细胞壁",
        "D": "细胞质"
      },
      "answer": "C",
      "analysis": "细胞壁、叶绿体和液泡是植物细胞特有的结构，动物细胞没有。",
      "knowledgePoints": [
        "细胞结构"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
