      "grade": 9,
      "questionType": "calculation",
      "text": "计算二氧化碳（CO₂）的相对分子质量。（相对原子质量：C=12，O=16）",
      "answer": "44",
      "analysis": "CO₂ 的相对分子质量 = 12 + 16×2 = 44。",
      "knowledgePoints": [
        "相对分子质量"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
