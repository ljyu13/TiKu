    {
      "id": "ljyu-jh-ch-04",
      "grade": 9,
      "questionType": "single_choice",
      "text": "下列化学用语中，表示两个氢分子的是哪一个？",
      "options": {
        "A": "2H",
        "B": "H₂",
        "C": "2H₂",
        "D": "2H⁺"
      },
      "answer": "C",
      "analysis": "2H 表示两个氢原子，H₂ 表示一个氢分子，2H₂ 表示两个氢分子。",
      "knowledgePoints": [
        "化学用语"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
