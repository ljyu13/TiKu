      "id": "ljyu-jh-ch-01",
      "grade": 9,
      "questionType": "single_choice",
      "text": "下列物质中，属于纯净物的是哪一个？",
      "options": {
        "A": "空气",
        "B": "海水",
        "C": "蒸馏水",
        "D": "食醋"
      },
      "answer": "C",
      "analysis": "蒸馏水只由水一种物质组成；空气、海水和食醋都由多种物质混合而成。",
      "knowledgePoints": [
        "纯净物与混合物"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-jh-ch-02",
      "grade": 9,
      "questionType": "fill_blank",
      "text": "写出氧气的化学式：___。",
      "answer": "O₂",
      "analysis": "氧气由氧分子构成，每个氧分子含两个氧原子，化学式为 O₂。",
      "knowledgePoints": [
        "化学式"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
