    {
      "id": "ljyu-jh-ma-01",
      "grade": 7,
      "questionType": "single_choice",
      "text": "计算 -3 + 5 的结果是？",
      "options": {
        "A": "-8",
        "B": "-2",
        "C": "2",
        "D": "8"
      },
      "answer": "C",
      "analysis": "异号两数相加，取绝对值较大数的符号，并用较大绝对值减去较小绝对值：5-3=2，结果为正 2。",
      "knowledgePoints": [
        "有理数加法"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-jh-ma-02",
      "grade": 7,
      "questionType": "fill_blank",
      "text": "若 |x| = 4，则 x 的值是___。",
      "answer": "4 或 -4",
      "analysis": "绝对值等于 4 的数有两个，分别是 4 和 -4。",
      "knowledgePoints": [
        "绝对值"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-jh-ma-03",
      "grade": 8,
      "questionType": "single_choice",
      "text": "下列图形中，一定是轴对称图形的是？",
      "options": {
        "A": "平行四边形",
        "B": "等腰三角形",
        "C": "任意三角形",
        "D": "梯形"
      },
      "answer": "B",
      "analysis": "等腰三角形沿底边中线所在直线对折能完全重合，是轴对称图形；平行四边形一般不是。",
      "knowledgePoints": [
        "轴对称"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-jh-ma-04",
      "grade": 8,
      "questionType": "calculation",
      "text": "解方程组：x + y = 7，x - y = 1。",
      "answer": "x = 4，y = 3",
      "analysis": "两式相加得 2x=8，x=4；代入第一式得 y=3。",
      "knowledgePoints": [
        "二元一次方程组"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-jh-ma-05",
      "grade": 9,
      "questionType": "single_choice",
      "text": "一元二次方程 x² - 5x + 6 = 0 的两个根是？",
      "options": {
        "A": "2 和 3",
        "B": "-2 和 -3",
        "C": "1 和 6",
        "D": "-1 和 -6"
      },
      "answer": "A",
      "analysis": "因式分解得 (x-2)(x-3)=0，所以两个根为 x=2 和 x=3。",
      "knowledgePoints": [
        "一元二次方程"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-jh-ma-06",
      "grade": 9,
      "questionType": "solution",
      "text": "已知一次函数 y = kx + b 的图象经过点 (0, 2) 和 (1, 5)，求这个函数的解析式。",
      "answer": "y = 3x + 2",
      "analysis": "把 (0,2) 代入得 b=2；把 (1,5) 代入得 k+b=5，所以 k=3。函数解析式为 y=3x+2。",
      "knowledgePoints": [
        "一次函数"
      ],
      "difficultyStars": 3,
      "source": "ljyu13 原创"
    }
  ]
