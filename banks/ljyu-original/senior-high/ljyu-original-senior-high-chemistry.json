    {
      "id": "ljyu-sh-ch-09",
      "grade": 12,
      "questionType": "solution",
      "text": "将 10 克碳酸钙充分加热分解，理论上可以得到氧化钙多少克？（CaCO₃ → CaO + CO₂；Ca=40，C=12，O=16）",
      "answer": "5.6克",
      "analysis": "CaCO₃ 摩尔质量 100 g/mol，CaO 为 56 g/mol。10 g CaCO₃ 为 0.1 mol，按 1:1 生成 0.1 mol CaO，质量为 0.1×56=5.6 g。",
      "knowledgePoints": [
        "化学计算"
      ],
      "difficultyStars": 3,
      "source": "ljyu13 原创"
    },
