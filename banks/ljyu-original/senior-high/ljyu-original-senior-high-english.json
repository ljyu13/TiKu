  "questions": [
    {
      "id": "ljyu-sh-en-01",
      "grade": 10,
      "questionType": "single_choice",
      "text": "—Where is your father? —He ___ to Shanghai on business.",
      "options": {
        "A": "has been",
        "B": "has gone",
        "C": "went",
        "D": "goes"
      },
      "answer": "B",
      "analysis": "“去了某地（还没回来）”用 has gone to；has been to 表示“去过（已回来）”。",
      "knowledgePoints": [
        "现在完成时"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-sh-en-02",
      "grade": 10,
      "questionType": "fill_blank",
      "text": "It is the first time that she ___ (visit) Beijing.",
      "answer": "has visited",
      "analysis": "“It is the first time that…”结构中，that 从句用现在完成时。",
      "knowledgePoints": [
        "固定句型"
      ],
      "difficultyStars": 3,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-sh-en-03",
      "grade": 11,
      "questionType": "single_choice",
      "text": "The girl ___ is standing there is my sister.",
      "options": {
        "A": "who",
        "B": "which",
        "C": "whom",
        "D": "whose"
      },
      "answer": "A",
      "analysis": "先行词 the girl 指人，定语从句中作主语，用关系代词 who 或 that。",
      "knowledgePoints": [
        "定语从句"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-sh-en-04",
      "grade": 11,
      "questionType": "true_false",
      "text": "在“If I were you, I would take the chance.”一句中，使用了虚拟语气。",
      "answer": "正确",
      "analysis": "与现在事实相反的假设，if 从句用过去式（be 动词常用 were），主句用 would+动词原形，是虚拟语气。",
      "knowledgePoints": [
        "虚拟语气"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-sh-en-05",
      "grade": 11,
      "questionType": "single_choice",
      "text": "___ from the top of the mountain, the city looks beautiful.",
      "options": {
        "A": "Seeing",
        "B": "To see",
        "C": "Seen",
        "D": "See"
      },
      "answer": "C",
      "analysis": "the city 与 see 是被动关系（城市被看），用过去分词 Seen 作状语。",
      "knowledgePoints": [
        "非谓语动词"
      ],
      "difficultyStars": 3,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-sh-en-06",
      "grade": 12,
      "questionType": "fill_blank",
      "text": "Hardly ___ he arrived home when it began to rain.",
      "answer": "had",
      "analysis": "hardly…when… 结构中，hardly 置于句首时主句用部分倒装，且常用过去完成时 had done。",
      "knowledgePoints": [
        "倒装句"
      ],
      "difficultyStars": 4,
      "source": "ljyu13 原创"
    }
  ]
