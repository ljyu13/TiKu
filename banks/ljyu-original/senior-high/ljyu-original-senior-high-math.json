      "id": "ljyu-sh-ma-01",
      "grade": 10,
      "questionType": "single_choice",
      "text": "已知集合 A={1,2,3}，B={2,3,4}，则 A∩B = ？",
      "options": {
        "A": "{1,2}",
        "B": "{1,2,3,4}",
        "C": "{2,3}",
        "D": "{4}"
      },
      "answer": "C",
      "analysis": "交集是两个集合的公共元素组成的集合，A 与 B 的公共元素是 2 和 3。",
      "knowledgePoints": [
        "集合运算"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-sh-ma-02",
      "grade": 10,
      "questionType": "fill_blank",
      "text": "函数 f(x)=√(x-2) 的定义域是___。",
      "answer": "x ≥ 2（即 [2, +∞)）",
      "analysis": "二次根式被开方数非负，x-2 ≥ 0，所以 x ≥ 2。",
      "knowledgePoints": [
        "函数定义域"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-sh-ma-03",
      "grade": 10,
      "questionType": "single_choice",
      "text": "已知等差数列 {aₙ} 中 a₁=1，公差 d=2，则 a₅ = ？",
      "options": {
        "A": "7",
        "B": "9",
        "C": "10",
        "D": "11"
      },
      "answer": "B",
      "analysis": "等差数列通项公式 aₙ=a₁+(n-1)d，所以 a₅=1+4×2=9，选 B。",
      "knowledgePoints": [
        "等差数列"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-sh-ma-04",
      "grade": 11,
      "questionType": "calculation",
      "text": "已知等比数列 {aₙ} 中 a₁=2，公比 q=3，求前 3 项的和 S₃。",
      "answer": "26",
      "analysis": "a₁=2，a₂=6，a₃=18，S₃=2+6+18=26。也可用公式 S₃=a₁(q³-1)/(q-1)=2×(27-1)/2=26。",
      "knowledgePoints": [
        "等比数列"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-sh-ma-05",
      "grade": 11,
      "questionType": "single_choice",
      "text": "已知向量 a=(1,2)，b=(3,-1)，则 a·b = ？",
      "options": {
        "A": "5",
        "B": "3",
        "C": "1",
        "D": "-1"
      },
      "answer": "C",
      "analysis": "向量数量积 a·b=1×3+2×(-1)=3-2=1。",
      "knowledgePoints": [
        "向量数量积"
      ],
      "difficultyStars": 2,
      "source": "ljyu13 原创"
    },
    {
      "id": "ljyu-sh-ma-06",
      "grade": 12,
      "questionType": "solution",
      "text": "已知函数 f(x)=x²-2x，求 f(x) 在区间 [0,3] 上的最大值和最小值。",
      "answer": "最大值为 3，最小值为 -1。",
      "analysis": "f(x)=(x-1)²-1，对称轴 x=1 在区间内，顶点处取得最小值 f(1)=-1；端点 f(0)=0，f(3)=3，故最大值为 f(3)=3。",
      "knowledgePoints": [
        "二次函数最值"
      ],
      "difficultyStars": 3,
      "source": "ljyu13 原创"
    }
  ]
